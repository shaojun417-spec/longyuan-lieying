{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react-jsx",
    "outDir": "dist-electron",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["vite.config.ts", "electron/src/main/**/*", "electron/src/preload/**/*"],
  "exclude": ["electron/src/renderer/**/*"]
}